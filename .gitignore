# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables and credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Local Database files (dev SQLite)
backend/database/*.sqlite
backend/database/*.sqlite-journal
backend/database/*.sqlite3
backend/database/*.db

# Uploaded user files (keep folder structure via .gitkeep)
backend/uploads/media/*
!backend/uploads/media/.gitkeep
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
backend/uploads/submissions/*
!backend/uploads/submissions/.gitkeep

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
