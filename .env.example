# ==============================================================================
# LifeTrace: Production Environment Configuration Template
# Instructions: Copy this file to .env and populate with production credentials.
# NEVER commit the active .env file to source control.
# ==============================================================================

# Server Environment
PORT=10000
NODE_ENV=production

# ------------------------------------------------------------------------------
# TiDB Cloud / MySQL Database Configuration
# TiDB Cloud Serverless clusters require TLS/SSL and operate on port 4000.
# ------------------------------------------------------------------------------
DB_ENGINE=mysql
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_cluster_user
DB_PASSWORD=your_tidb_cluster_strong_password
DB_NAME=lifetrace_db

# Enforce TLS 1.2+ encrypted connection (Mandatory for TiDB Cloud)
DB_SSL=true

# Optional: Path to custom CA certificate if needed (leave empty for system CAs)
DB_SSL_CA=

# Strict MySQL mode (strictly forbids dev SQLite fallback in production)
STRICT_MYSQL=true

# ------------------------------------------------------------------------------
# Session Security
# Generate a cryptographically strong secret (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ------------------------------------------------------------------------------
SESSION_SECRET=change_this_to_a_secure_random_64_character_string_for_production
SESSION_LIFETIME_HOURS=24

# ------------------------------------------------------------------------------
# CORS & Allowed Origins (Optional: Leave empty to allow same-origin and onrender.com)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# File Upload Limits
# ------------------------------------------------------------------------------
UPLOAD_DIR=backend/uploads
UPLOAD_MAX_SIZE_MB=25

# ------------------------------------------------------------------------------
# Initial Administrator Setup (Used by: npm run admin:init)
# Note: In production, npm run admin:init requires ADMIN_PASSWORD to be defined.
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lifetrace.ug
ADMIN_PASSWORD=your_secure_admin_password_min_8_chars
